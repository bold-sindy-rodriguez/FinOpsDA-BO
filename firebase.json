{
  "firestore": [
    {
      "database": "ntr-boldcf",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "site": "ntrcfbold",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "**/.git/**",
      ".gitignore",
      "**/.*",
      "**/node_modules/**",
      "firebase-debug.log",
      "**/firebase-debug.log",
      "apps-script/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/login.html",
        "type": 302
      }
    ]
  }
}
